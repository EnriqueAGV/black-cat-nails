# ── Sesión de la web (cookie httpOnly) ──────────────────────────────────────
# Cadena aleatoria de 32+ caracteres. Generar con: openssl rand -base64 32
SESSION_SECRET=

# ── Firebase en el navegador (Authentication) ───────────────────────────────
# Los mismos valores de la app web registrada en Firebase que usa la app móvil
# (EXPO_PUBLIC_FIREBASE_* en el .env de la raíz). No son secretos.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin en el servidor (Route Handlers de /api) ──────────────────
# Cuenta de servicio del mismo proyecto. SECRETO: nunca subirlo a GitHub.
# Opción A: el JSON completo en una sola línea
FIREBASE_SERVICE_ACCOUNT=
# Opción B: los tres campos por separado (la llave con \n literales)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Emuladores locales (opcional) ───────────────────────────────────────────
# NEXT_PUBLIC_USAR_EMULADORES=1
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_PROJECT_ID=demo-black-cat-nails
